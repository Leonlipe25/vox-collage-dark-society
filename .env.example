# ============================================================================
# VOX COLLAGE DARK SOCIETY — CONFIGURAÇÃO DE API DE VOZ (TTS)
# Copie este arquivo para `.env` e preencha PELO MENOS UMA das chaves abaixo
# (Caso você envie o roteiro com o áudio .mp3 já pronto via --from-audio,
#  não é necessário preencher nenhuma chave!)
# ============================================================================

# OPÇÃO 1: DarkPlanner TTS API (Gera MP3 + SRT palavra por palavra nativo)
DARKPLANNER_API_KEY=""

# OPÇÃO 2: Google Gemini TTS API (Crie grátis em https://aistudio.google.com/apikey)
# Vozes disponíveis: Charon, Orus, Fenrir, Puck, Kore, Aoede
GEMINI_API_KEY=""
